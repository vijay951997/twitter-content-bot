# Copy to .env and fill in. Never commit .env.

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/xbot
SPRING_DATASOURCE_USERNAME=xbot
SPRING_DATASOURCE_PASSWORD=

# --- First dashboard login (created only when the users table is empty; min 12 chars) ---
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# --- OpenAI (Phase 2) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- X API v2, OAuth 2.0 PKCE (Phase 5) ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# --- App ---
APP_TIMEZONE=Asia/Kolkata
POST_SCHEDULE_MORNING=08:00
POST_SCHEDULE_AFTERNOON=13:00
POST_SCHEDULE_EVENING=19:00
ENABLED_LANGUAGES=ta,en

# Dev only: origin of the Vite dev server (Docker setup is same-origin and ignores this)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false
