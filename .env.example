# Copy to .env and fill in. Never commit .env.

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/xbot
SPRING_DATASOURCE_USERNAME=xbot
SPRING_DATASOURCE_PASSWORD=

# --- First dashboard login (created only when the users table is empty; min 12 chars) ---
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# --- OpenAI (Phase 2) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- X API v2, OAuth 2.0 PKCE ---
# From console.x.com > your app > Keys and tokens > OAuth 2.0 Client ID and Client Secret.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must match the callback URL registered in your X app EXACTLY, and you must open the dashboard
# on the same host (http://localhost:3000, not 127.0.0.1) so your login session survives the redirect.
X_REDIRECT_URI=http://localhost:3000/api/x/callback

# Encrypts X tokens in the database (AES-256). 32 random bytes, base64. Generate one with:
#   docker run --rm alpine sh -c "head -c 32 /dev/urandom | base64"
# Keep it safe: if it changes, you must reconnect X.
APP_TOKEN_ENCRYPTION_KEY=

# --- App ---
APP_TIMEZONE=Asia/Kolkata
POST_SCHEDULE_MORNING=08:00
POST_SCHEDULE_AFTERNOON=13:00
POST_SCHEDULE_EVENING=19:00
ENABLED_LANGUAGES=ta,en

# Dev only: origin of the Vite dev server (Docker setup is same-origin and ignores this)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false
